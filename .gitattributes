# 换行符策略：shell 脚本与单元文件必须是 LF，否则在 NAS 上会因 \r 报错
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
*.json    text eol=lf

# Windows 侧脚本用 CRLF
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# 二进制
*.png     binary
*.zip     binary
*.tar.gz  binary
